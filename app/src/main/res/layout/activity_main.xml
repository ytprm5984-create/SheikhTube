  <EditText android:id="@+id/address" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:hint="Search or type URL" android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#AAAAAA" android:backgroundTint="#FF2020"/>
  <Button android:id="@+id/go" android:layout_width="56dp" android:layout_height="48dp" android:text="Go"/>
  <Button android:id="@+id/menu" android:layout_width="56dp" android:layout_height="48dp" android:text="⚙"/>
 </LinearLayout>
 <WebView android:id="@+id/web" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
